# Windows runners check out with core.autocrlf=true. Golden files are compared
# byte for byte, so a CRLF rewrite would fail every teatest assertion on
# Windows and nowhere else.
*.golden -text

# docs/keybindings.md is generated from the keymap and compared against it by a
# test, so it is the same byte-for-byte case as a golden file — and it failed on
# Windows and nowhere else until this line existed. The rest of the markdown
# goes the same way because a Go repository is an LF repository.
*.md text eol=lf

# Go tooling assumes LF, and the pre-push hook is run by sh.
*.go text eol=lf
*.mod text eol=lf
*.sum text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
scripts/hooks/* text eol=lf
Makefile text eol=lf
